# Copy this file to .env and fill in real values before running the app.

# --- Database (Postgres via Netlify DB) ---
# Deployed: provisioned and connected automatically by @netlify/database, no value needed here.
# Local dev: point at any Postgres instance (Netlify DB branch via `netlify dev`, or your own).
DATABASE_URL=""

# --- Admin login ---
# Seeded into the AdminUser table the first time you run `npx prisma db seed`.
# Changing these after the first seed requires re-running the seed or editing
# the admin account from the database directly.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-before-launch"

# --- Sessions ---
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# --- Email notifications (optional) ---
# Leave blank to no-op (logs to the server console instead of sending email).
# Works with a Gmail "App Password" (not your normal password) or any SMTP relay.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="yourbarbershop@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# SMTP_FROM="Cuts by Scrap <yourbarbershop@gmail.com>"
ADMIN_NOTIFICATION_EMAIL="you@example.com"

# --- SMS notifications (optional, future) ---
# Uncomment and fill in once you sign up for Twilio. Until then, SMS sends
# are no-ops that just log to the console — see src/lib/notifications.ts.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""

# --- Cron (24h appointment reminders) ---
# Any long random string — protects /api/cron/reminders from public calls.
# Vercel Cron automatically sends this as a Bearer token when CRON_SECRET is set.
CRON_SECRET="replace-with-a-random-string"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
